FLASK_ENV=development
FLASK_DEBUG=true
SECRET_KEY=change-this-secret
JWT_SECRET_KEY=change-this-jwt-secret
JWT_EXPIRES_IN_MINUTES=1440
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/maua_pricing_ai
FRONTEND_URL=http://localhost:5173
FRONTEND_ORIGIN=http://127.0.0.1:5173

# Monday.com - demanda comercial e boards de projetos
MONDAY_API_KEY=
MONDAY_API_URL=https://api.monday.com/v2
MONDAY_API_VERSION=2026-04
MONDAY_REQUEST_TIMEOUT_SECONDS=10
MONDAY_BOARD_ID=

# Importacao do historico - usuario existente que sera dono dos registros
HISTORICAL_IMPORT_USER_EMAIL=teste@mauajr.com

# OpenAI - assistente de precificacao com cobranca por uso
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# OpenRouter - compatibilidade com a integracao existente
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_TITLE=Maua Jr Pricing AI

# Futuras integracoes: adicione novas chaves somente no backend.
